{
  "name": "nexora-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "Nexora Enterprise ERP \u2014 web and desktop shells over shared @pepbits packages.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "dev": "turbo run dev",
    "dev:all": "node ../dummy-api/server.mjs & turbo run dev",
    "dev:api": "node ../dummy-api/server.mjs",
    "dev:web": "npm run dev -w web",
    "dev:desktop": "npm run dev -w desktop",
    "desktop": "npm run tauri -w desktop -- dev",
    "verify:parity": "node scripts/verify-parity.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "turbo": "^2",
    "typescript": "^5.9.3"
  },
  "packageManager": "npm@11.13.0"
}
