{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "allowJs": false,
    /* Permits `import "./thing.ts"`. Additive -- extensionless specifiers still
       work, and every package here already uses them. It exists so the @pepbits/ai-*
       packages can be imported directly by Node, which strips types but will not
       guess an extension. That is what lets scripts/verify-ai-*.mjs exercise the
       REAL modules with no bundler and no test dependency; a copied resolver in a
       test file is a resolver that can drift from the one that ships.
       Safe because every project here sets noEmit. */
    "allowImportingTsExtensions": true,

    /* The jest-dom matchers, declared once for every package rather than in
       whichever one last grew tests. `npm test` transpiles and does not
       typecheck, so a package missing this is green in vitest and red in tsc --
       two tools disagreeing with only one of them watched. That has now caught
       this repo out three times. */
    "types": ["vitest/globals", "@testing-library/jest-dom"]
  }
}
